[Unit]
Description=MyClaude verified executor daemon
After=network-online.target

[Service]
Type=simple
ExecStart=__MYCLAUDED_EXECUTABLE__ server run
Restart=on-failure
RestartSec=5
UMask=0077
Environment=MYCLAUDE_SOCKET=__MYCLAUDE_SOCKET__
Environment=MYCLAUDE_STATE_ROOT=__MYCLAUDE_STATE_ROOT__
Environment=M365_STATE_DIR=__M365_STATE_DIR__
Environment=M365_CONFIG_DIR=__M365_CONFIG_DIR__
Environment=M365_LOCAL_ENV=__M365_LOCAL_ENV__
Environment=MYCLAUDE_HOOK_SETTINGS=__MYCLAUDE_HOOK_SETTINGS__
Environment=MYCLAUDE_EXECUTION_PROFILE=__MYCLAUDE_EXECUTION_PROFILE__
Environment=MYCLAUDE_EXECUTOR_BIN=__MYCLAUDE_EXECUTOR_BIN__
Environment=MYCLAUDE_EXECUTOR_ARGS=__MYCLAUDE_EXECUTOR_ARGS__
Environment=MYCLAUDE_EXECUTOR_RESUME=__MYCLAUDE_EXECUTOR_RESUME__
Environment=MYCLAUDE_CONCURRENCY=__MYCLAUDE_CONCURRENCY__
Environment=MYCLAUDE_ALLOWED_WORKSPACE_ROOTS=__MYCLAUDE_ALLOWED_WORKSPACE_ROOTS__
Environment=MYCLAUDE_BWRAP_BIN=__MYCLAUDE_BWRAP_BIN__
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
