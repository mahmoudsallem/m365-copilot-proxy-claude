{
  "name": "m365-copilot-proxy",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "auth": "node scripts/auth-interactive.mjs",
    "auth:device": "node scripts/auth-device.mjs",
    "local": "bash scripts/local.sh",
    "setup:local": "bash scripts/setup-local.sh",
    "dev": "pnpm --filter @m365-copilot/proxy dev",
    "build": "pnpm -r build",
    "proxy": "node packages/proxy/bin/m365-proxy.mjs",
    "proxy:local": "bash scripts/run-proxy-local.sh",
    "pi": "bash scripts/pi-local.sh",
    "pi:sandbox": "bash scripts/pi-sandbox.sh",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build && npx vitest run",
    "test:e2e:sandbox": "bash scripts/tests/e2e-sandbox.sh",
    "test:launchers": "bash scripts/tests/launcher-smoke.sh",
    "test:live": "pnpm build && M365_LIVE=1 npx vitest run",
    "tui": "node bin/m365-tui.mjs",
    "prompts:fetch": "node scripts/fetch-system-prompts.mjs --list",
    "agents": "node scripts/agents-parallel.mjs",
    "validate:models": "node scripts/validate-models.mjs"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "tsdown": "^0.21.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
